# General Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shares-of-goodness?retryWrites=true&w=majority

# Security and Auth
FRONTEND_URL=https://your-frontend-vercel-app.vercel.app
JWT_SECRET=your_jwt_secret_key_here

# Payment Settings
STRIPE_SECRET_KEY=sk_test_...

# Email configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password

# Supabase Storage Configuration (Required for file uploads)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key
SUPABASE_BUCKET_NAME=donation-receipts

# Telegram Bot configuration (Required for telegram admin alerts)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789

# Firebase Cloud Messaging Service Account (Required for FCM Push Notifications)
# Stringified single-line JSON structure:
# Example: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
